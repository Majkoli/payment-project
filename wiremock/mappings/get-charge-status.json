{
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/charges/[^/]+"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "id": "{{request.pathSegments.[2]}}",
      "status": "authorized"
    },
    "transformers": ["response-template"]
  }
}
